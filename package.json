{
  "name": "been",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "verify": "yarn lint && yarn knip && yarn test && yarn build",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview",
    "format": "biome format --write .",
    "deploy": "yarn build && gh-pages -d dist"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "yarn@1.22.22",
  "homepage": "https://iwonz.github.io/been",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "gh-pages": "^6.3.0",
    "knip": "^6.44.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
